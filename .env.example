# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# GMAIL_APP_PASSWORD is NOT your normal Gmail password. It is a 16-character
# app password from https://myaccount.google.com/apppasswords, which requires
# 2-Step Verification to be on. See README.md, "Setup".
#
# Spaces in the app password are fine to strip out; Google displays it in
# four blocks of four purely for readability.

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
FROM_NAME=Your Name
